/*======================================================================================

  D E P E N D E N C I E S   L A Y E R

  Single include point for the DRU build.

  Include this one header to get every declaration the DRU build needs; the
  individual headers are pulled in below in dependency order.

  NOTE: these are deliberately kept as separate files rather than pasted into
  one blob. Some of them include ctrl.h, and ctrl.h includes this file back --
  a cycle that only resolves because each header still carries its own include
  guard. Flattening them into a single guarded file makes ctrl.h parse before
  acc_reg_t / trf_pymt_mny_rec_t exist, and the build fails.

======================================================================================*/
#ifndef __DEPENDENCIES_LAYER_H
