      iec_62056_21_slave_task();
#endif
}  
#endif
#endif
      if (Boot_loader_flag ==NO_BOOTLOADER_DATA)
      {
		//contact_task();
#if defined(DLMS_ENABLED) || defined (HDLC_PROTOCOL)
        Dlms_Main_gManager();
#endif
#ifdef DLMS_ENABLED
        Cal_Evt_gEventNotificationManager();
#endif
#if ((defined (RFID_FEATURE) && !defined(EM_DL130_BOARD)))
        if(g_jig_start ==0)
        /*! - Call RFID task function.*/
       { rfid_task();  }
#else
           RFID_idle_flag = 1;
#endif
      }
    }
#ifdef MODEM_ENABLE
    /*! - Call SIM900 task function.*/
    MODEM_task();
#endif
#if defined(DLMS_ENABLED) || defined (HDLC_PROTOCOL)
if(!rise_iec_flag)
  HDLC_task();
#endif
