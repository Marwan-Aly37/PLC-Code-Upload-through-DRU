/*!
* @brief Write raw meter data to a buffer.
*
* @par Description:
* This function writes meter data to a buffer. Meter data is divided into parts
* each part belongs to a separate module to reduce overhead of transfering data
* as one chunk.
*
* @param [out] buffer_ptr Address of first byte in the buffer to get data.
* @param [in] type Type of data required #comm_raw_data_t .
*
* @return Size of data written in buffer.
*
* @note Main meter data size is fixed regardless of defined features as example,
* if the BPH feature is not defined the sent number of BPH records is zero.
*/
#ifdef TEST_ENDIANNESS_RAW_DATA
void fill_data(uint8_t* ptr_data ,uint16_t length_var)
{
  uint16_t index=0,index1=0;
  uint8_t *ptr_struct;
  ptr_struct = ptr_data;
  for(index=0;index<length_var;index++)
  {
    ptr_struct[index] =index1;
    index1++;
    if(index1>10)
    {
      index1 =0;
    }
  }
}
#endif
uint16_t comm_read_raw_data(uint8_t *buffer_ptr, uint8_t type)
{
  /*!@par Pseudo Code:*/
  uint8_t *buffer_index = buffer_ptr;
#if defined (MTR_SINGLE_PH) ||defined(ASHNTTI_PROJECT)
  uint8_t*buffer_ptr_endian=buffer_ptr;
#endif
  uint8_t len = 0;
  memset(buffer_ptr, 0, MAIN_DATA_SIZE);
  uint16_t cal=0;
  switch(type)
  {
    /*! - Check type of data required.*/
  case COMM_MAIN_DATA:
    /*! If the type is main meter data.*/
    /*! - Write endian format and time now.*/
#ifdef BIG_ENDIAN
    buffer_ptr[0] = 1;
#else
    buffer_ptr[0] = 0;
#endif
    buffer_ptr[1] = COMM_MIN;
    buffer_ptr[2] = COMM_HR;
    buffer_ptr[3] = COMM_DAY;
    buffer_ptr[4] = COMM_MONTH;
    buffer_ptr[5] = COMM_YEAR;
    /*! - Get firmware version and defined feature.*/
    memcpy(buffer_ptr + 6, COMM_GET_FIRMWARE_VERSION(), 6);
    CTRL_READ_TMPLT_ID(buffer_ptr + 12);
#ifdef MTR_SINGLE_PH
    var_temp_size =0x80;
    big_endian_memcpy(buffer_ptr + 12, buffer_ptr + 12,&var_temp_size, 2);
#endif
    COMM_GET_TRF_FETUR(buffer_ptr + 14);
    COMM_GET_MTR_FETUR(buffer_ptr + 18);
    COMM_GET_CTRL_FETUR(buffer_ptr + 22);
#ifdef ASHNTTI_PROJECT
    buffer_ptr[26] = COMM_GET_DSPLY_FETUR();
#else
#ifdef MTR_SINGLE_PH
    uint16_t ver;
    ver = SwapEndian16(ctrl_sys_new_var.boot_ver);
    memcpy(&buffer_ptr[26],(uint8_t*)&ver,2);
#else
    memcpy(&buffer_ptr[26],&ctrl_sys_new_var.boot_ver,2);
#endif
#endif
    buffer_ptr[28] = COMM_GET_RFID_FETUR();
    buffer_ptr[29] = COMM_GET_GPRS_FETUR();
#ifdef RF_LINK_FEATURE
    buffer_ptr[30] = COMM_GET_RF_FETUR();
#else
    buffer_ptr[30] = 0;
#endif    
    buffer_ptr[31] = COMM_GET_IEC_FETUR();
    /*! - Get new tamper status and number of records saved in all logs.*/
    buffer_ptr[32] = GET_NEW_TMPR_FLG();
    if (GET_NO_OF_SAVED_BPH_REC() > 255)
      buffer_ptr[33] = 255;
    else
      buffer_ptr[33] = GET_NO_OF_SAVED_BPH_REC();
    if (GET_NO_OF_SAVED_EVNT_REC() > 0xffff)
    {
      buffer_ptr[34] = 0xff;
      buffer_ptr[35] = 0xff;
    }
    else
    {
#ifdef MTR_SINGLE_PH
      buffer_ptr[35] = (uint8_t)(GET_NO_OF_SAVED_EVNT_REC() & 0x00ff);
      buffer_ptr[34] = (uint8_t)((GET_NO_OF_SAVED_EVNT_REC() >> 8) & 0x00ff);
#else
      buffer_ptr[34] = (uint8_t)(GET_NO_OF_SAVED_EVNT_REC() & 0x00ff);
      buffer_ptr[35] = (uint8_t)((GET_NO_OF_SAVED_EVNT_REC() >> 8) & 0x00ff);
#endif
    }
    if (GET_NO_OF_SAVED_MNY_REC()>255)
    {
      buffer_ptr[36] = 0xff;
    }
    else
      buffer_ptr[36] = GET_NO_OF_SAVED_MNY_REC();
    if (GET_NO_OF_SAVED_PRFLE_REC() > 0xffff)
    {
      buffer_ptr[37] = 0xff;
      buffer_ptr[38] = 0xff;
    }
    else
    {
#ifdef MTR_SINGLE_PH
      buffer_ptr[38] = (uint8_t)(GET_NO_OF_SAVED_PRFLE_REC() & 0x00ff);
      buffer_ptr[37] = (uint8_t)((GET_NO_OF_SAVED_PRFLE_REC() >> 8) & 0x00ff);
#else
      buffer_ptr[37] = (uint8_t)(GET_NO_OF_SAVED_PRFLE_REC() & 0x00ff);
      buffer_ptr[38] = (uint8_t)((GET_NO_OF_SAVED_PRFLE_REC() >> 8) & 0x00ff);
#endif
    }
    if (GET_NO_OF_SAVED_CFG_METER_REC() > 255)
      buffer_ptr[39] = 255;
    else
      buffer_ptr[39] = (uint8_t) GET_NO_OF_SAVED_CFG_METER_REC();
    GET_SERIAL_NUMBER(&buffer_ptr[40]);
#ifdef MTR_SINGLE_PH
 //   var_temp_size =0xc0;
 //   big_endian_memcpy(&buffer_ptr[40], &buffer_ptr[40],&var_temp_size, 4); already done in get serial function
#endif
    /*! - Return size of main meter data packet #MAIN_DATA_SIZE .*/
    return MAIN_DATA_SIZE;
  case COMM_TRF_DATA:
    /*! If the type is tariff and payment data.*/
#ifdef TARIFF_SYS
    /*! - Copy tariff structure.*/
#ifdef  ASHNTTI_PROJECT
    buffer_ptr += trf_pymt_get_tariff_data(buffer_ptr);
    var_temp_size =0xf6;
    big_endian_memcpy(buffer_ptr_endian,buffer_ptr_endian,&var_temp_size,88);
    
    buffer_ptr_endian =buffer_ptr;
#else
#ifdef MTR_SINGLE_PH
    buffer_ptr += trf_pymt_get_tariff_data(buffer_ptr)-1;
    var_temp_size =0xf6;
    big_endian_memcpy(buffer_ptr_endian,buffer_ptr_endian,&var_temp_size,88);

    buffer_ptr_endian =buffer_ptr;
    memcpy(buffer_ptr,(uint8_t*)&ctrl_sys_var_optional_feature.friendly_amount_consumed_kwh,sizeof(ctrl_sys_var_optional_feature.friendly_amount_consumed_kwh));
    buffer_ptr += sizeof(ctrl_sys_var_optional_feature.friendly_amount_consumed_kwh);
    *(buffer_ptr++) =TRF_PYMT_GET_CURR_TRF();
    memcpy(buffer_ptr,(uint8_t*)&ctrl_sys_var_optional_feature.prv_actv_trf_step_wh,sizeof(ctrl_sys_var_optional_feature.prv_actv_trf_step_wh));
    buffer_ptr += sizeof(ctrl_sys_var_optional_feature.prv_actv_trf_step_wh);
    big_endian_memcpy(buffer_ptr_endian,buffer_ptr_endian,tariff_data_extnsion,45);
#else
    buffer_ptr += trf_pymt_get_tariff_data(buffer_ptr);
#endif
#endif
#endif
#ifdef PAYMENT_SYS
    /*! - Copy payment structure.*/
#ifdef MTR_SINGLE_PH
    buffer_ptr_endian =buffer_ptr;
#endif
    buffer_ptr += trf_pymt_get_pymt_data(buffer_ptr);
#ifdef MTR_SINGLE_PH
    big_endian_memcpy(buffer_ptr_endian,buffer_ptr_endian,pymt_data_ar_size,0x52);

    buffer_ptr_endian =buffer_ptr;
#ifndef ASHNTTI_PROJECT
    var_temp_size =0xc0;
    memcpy(buffer_ptr,(uint8_t*)&ctrl_sys_var_optional_feature.postpaid_bill,sizeof(ctrl_sys_var_optional_feature.postpaid_bill));
    buffer_ptr += sizeof(ctrl_sys_var_optional_feature.postpaid_bill);
    big_endian_memcpy(buffer_ptr_endian,buffer_ptr_endian,&var_temp_size,4);
#endif
#endif
#endif
#ifdef TRF_USE_MD_KW
    /*! - Copy active power MD structure.*/
#ifdef MTR_SINGLE_PH
    buffer_ptr_endian =buffer_ptr;
#endif
    buffer_ptr += trf_pymt_get_md_kw_data(buffer_ptr);
#ifdef MTR_SINGLE_PH
    big_endian_memcpy(buffer_ptr_endian,buffer_ptr_endian,trf_pymt_md_par_ar_size,58);
#endif
#endif
#ifdef TRF_USE_MD_KVA
    /*! - Copy reactive power MD structure.*/
    buffer_ptr += trf_pymt_get_md_kva_data(buffer_ptr);
#endif
#ifdef TRF_USE_MD_A
#ifdef MTR_SINGLE_PH
    buffer_ptr_endian =buffer_ptr;
#endif
    /*! - Copy electrical current MD structure.*/
    buffer_ptr += trf_pymt_get_md_a_data(buffer_ptr);
#ifdef MTR_SINGLE_PH
    big_endian_memcpy(buffer_ptr_endian,buffer_ptr_endian,trf_pymt_md_par_ar_size,58);
#else
    memcpy(buffer_ptr,(uint8_t*)&ctrl_sys_var_optional_feature.postpaid_bill,sizeof(ctrl_sys_var_optional_feature.postpaid_bill));
    buffer_ptr += sizeof(ctrl_sys_var_optional_feature.postpaid_bill);
    
    memcpy(buffer_ptr,(uint8_t*)&ctrl_sys_var_optional_feature.friendly_amount_consumed_kwh,sizeof(ctrl_sys_var_optional_feature.friendly_amount_consumed_kwh));
    buffer_ptr += sizeof(ctrl_sys_var_optional_feature.friendly_amount_consumed_kwh);
    
    memcpy(buffer_ptr,(uint8_t*)&ctrl_sys_var_optional_feature.prv_actv_trf_step_wh,sizeof(ctrl_sys_var_optional_feature.prv_actv_trf_step_wh));
    buffer_ptr += sizeof(ctrl_sys_var_optional_feature.prv_actv_trf_step_wh);
#endif
#endif
    return (buffer_ptr - buffer_index);
  case COMM_METERING_DATA:
    /*! - Copy metering accumlation registers.*/
    buffer_ptr += mtr_get_acc_reg(buffer_ptr);
#ifdef MTR_SINGLE_PH
    big_endian_memcpy(buffer_ptr_endian,buffer_ptr_endian,acc_en_reg_t_ar_size,sizeof(mtr_data.mtr_data_mem.mtr_acc_md.acc_mic_en_reg.acc_en_reg));
    /*! - Copy metering MD registers.*/
    buffer_ptr_endian =buffer_ptr;
    buffer_ptr += mtr_get_md_reg(buffer_ptr);//redatodo
    big_endian_memcpy(buffer_ptr_endian,buffer_ptr_endian,md_reg_t_ar_size,sizeof(mtr_data.mtr_data_mem.mtr_acc_md.md_reg));
#else
    /*! - Copy metering MD registers.*/
    buffer_ptr += mtr_get_md_reg(buffer_ptr);
#endif
    return (buffer_ptr - buffer_index);
  case COMM_CTRL_DATA:
    /*! If the type is control data, copy data and return its size.*/
    buffer_ptr += ctrl_read_data(buffer_ptr);
#ifdef MTR_SINGLE_PH
#ifdef ASHNTTI_PROJECT
    big_endian_memcpy(buffer_ptr_endian,buffer_ptr_endian,basic_ar_size,38);
#else
    big_endian_memcpy(buffer_ptr_endian,buffer_ptr_endian,basic_ar_size,44);
#endif
#endif
    COMM_RESET_RFID_TAMPER();
    return (buffer_ptr - buffer_index);
// #ifdef SYSLINK_ENABLE
  case COMM_METERING_INST_DATA:
#ifdef ASHNTTI_PROJECT
    if(CTRL_BZR_STAT || CTRL_READ_HINT_BY_RLY_STAT)
      *buffer_ptr = HINT_STAT_MASK;
#ifdef GPRS_FEATURE
    if(GPRS_SERVER_STATE())
      *buffer_ptr |= GPRS_ICON_MASK;
#endif
#ifdef RFID_FEATURE
    if(RFID_DATA_WRITTEN())
      *buffer_ptr |= RFID_ICON_MASK;
#endif
#endif
    buffer_ptr++;
    /*! - Copy metering instantaneous registers.*/
    buffer_ptr += mtr_get_inst_reg(buffer_ptr);
    /*! - Copy meter status.*/
    buffer_ptr += ctrl_read_meter_status(buffer_ptr);
#if (defined(CTRL_CVR_SW) || defined(CTRL_TRMNL_SW) || defined(CTRL_MGNT_SW) ||\
    defined(CTRL_MGNT_SENSOR) || defined(MTR_RVS_TMPR) || defined(MTR_ERTH_TMPR)\
      || defined(MTR_MIS_POT_TMPR) || defined(MTR_THREE_PH) || defined(CTRL_GPRS_MODULE_CVR_SW))
/*! - Copy tamper count.*/
memcpy(buffer_ptr, &CTRL_TMPR_COUNT(), sizeof(CTRL_TMPR_COUNT()));
buffer_ptr += sizeof(CTRL_TMPR_COUNT());
#endif
#ifdef GPRS_FEATURE
/*! - Read GPRS signal strength.*/
memcpy(buffer_ptr, &CTRL_READ_GPRS_SIGNAL_STRENGTH(), sizeof(CTRL_READ_GPRS_SIGNAL_STRENGTH()));
buffer_ptr += sizeof(CTRL_READ_GPRS_SIGNAL_STRENGTH());
#endif
#ifdef GPRS_SRT_CARD
buffer_ptr += COMM_READ_SCRTCH_CARD_STAT(buffer_ptr);
#endif
#ifdef MTR_ENABLE_LMT
//*((uint16_t*) buffer_ptr) = MTR_GET_OVR_VLT();
*buffer_ptr = (uint8_t)(MTR_GET_OVR_VLT() & 0x00ff);
*(buffer_ptr + 1) = (uint8_t)((MTR_GET_OVR_VLT() >> 8) & 0x00ff);
buffer_ptr += sizeof(MTR_GET_OVR_VLT());
*buffer_ptr = MTR_GET_UDR_VLT();
buffer_ptr += sizeof(MTR_GET_UDR_VLT());
*buffer_ptr = MTR_GET_OVR_LOD();
buffer_ptr += sizeof(MTR_GET_OVR_LOD());
#endif
COMM_RESET_RFID_TAMPER();
return (buffer_ptr - buffer_index);
// #endif
#ifdef TARIFF_SYS
  case COMM_TRF_CFG:
    /*! - Copy tariff configuration.*/
    buffer_ptr += trf_pymt_get_tariff_cfg(buffer_ptr);
#ifdef MTR_SINGLE_PH
    big_endian_memcpy(buffer_ptr_endian, buffer_ptr_endian,trf_t_ar_size, 160);
#endif
    return (buffer_ptr - buffer_index);
#endif
#ifdef PAYMENT_SYS
  case COMM_PYMT_CFG:
    /*! - Copy payment configuration.*/
    buffer_ptr += trf_pymt_get_payment_cfg(buffer_ptr);
#ifdef MTR_SINGLE_PH
    big_endian_memcpy(buffer_ptr_endian, buffer_ptr_endian,trf_pymt_t_ar_size, 14);
#endif
    return (buffer_ptr - buffer_index);
#endif
#ifdef PYMT_TAX
  case COMM_TAX_CFG:
    /*! - Copy tax configuration.*/
    buffer_ptr += trf_pymt_get_tax_cfg(buffer_ptr);
#ifdef MTR_SINGLE_PH
    big_endian_memcpy(buffer_ptr_endian,buffer_ptr_endian,tax_t_ar_size, 9);
#endif
    return (buffer_ptr - buffer_index);
#endif
    
    // ADDED BY AMR
  case COMM_VACATION_CFG_DATA:
    
    memcpy(buffer_ptr, &(trf_pymt_cfg.vac), sizeof(trf_pymt_cfg.vac));
    buffer_ptr += sizeof(trf_pymt_cfg.vac);
    return (buffer_ptr - buffer_index);
    
    break;
    
  case COMM_FRIENDLY_CFG_DATA:
    
    memcpy(buffer_ptr, &(trf_pymt_cfg.frndly), sizeof(trf_pymt_cfg.frndly));
    buffer_ptr += sizeof(trf_pymt_cfg.frndly);
    return (buffer_ptr - buffer_index);
    
    break;
    
  case COMM_PYMENT_CFG_DATA:
    
    memcpy(buffer_ptr, &(trf_pymt_cfg.pymt), sizeof(trf_pymt_cfg.pymt));
#ifdef MTR_SINGLE_PH
    big_endian_memcpy(buffer_ptr_endian, buffer_ptr_endian,trf_pymt_t_ar_size, 14);
#endif
    buffer_ptr += sizeof(trf_pymt_cfg.pymt);
    return (buffer_ptr - buffer_index);
    
    break;
    
  case COMM_TARIFF_CFG_DATA:

    memcpy(buffer_ptr, &(trf_pymt_cfg.trf), sizeof(trf_pymt_cfg.trf));
#ifdef MTR_SINGLE_PH
    big_endian_memcpy(buffer_ptr_endian, buffer_ptr_endian,trf_t_ar_size, 160);
#endif
    buffer_ptr += sizeof(trf_pymt_cfg.trf);
    return (buffer_ptr - buffer_index);
    
    break;
    
  case COMM_TAX_CFG_DATA:

    memcpy(buffer_ptr, &(trf_pymt_cfg.tax), sizeof(trf_pymt_cfg.tax));
#ifdef MTR_SINGLE_PH
    big_endian_memcpy(buffer_ptr_endian,buffer_ptr_endian,tax_t_ar_size, 9);
#endif
    buffer_ptr += sizeof(trf_pymt_cfg.tax);
    return (buffer_ptr - buffer_index);
    
    break;
    
  case COMM_BP_CFG_DATA:

    memcpy(buffer_ptr, &(trf_pymt_cfg.bp), sizeof(trf_pymt_cfg.bp));
    buffer_ptr += sizeof(trf_pymt_cfg.bp);
    return (buffer_ptr - buffer_index);
    
    break;
    
    
  case COMM_CONTROL_CFG_DATA:

    len = display_get_ctrl_data(buffer_ptr); 
#ifdef MTR_SINGLE_PH
    big_endian_memcpy(buffer_ptr_endian,buffer_ptr_endian,display_ctrl_data_t_ar_size, 7);
#endif
    buffer_ptr += len;
    return (buffer_ptr - buffer_index);
    
    break;
    
  case COMM_MAXIMUM_DEMAND_CFG_DATA:
    
    memcpy(buffer_ptr, &(mtr_cfg.mtr_md_cfg), sizeof(mtr_cfg.mtr_md_cfg));
    buffer_ptr += sizeof(mtr_cfg.mtr_md_cfg);
    return (buffer_ptr - buffer_index);
    
    break;
    
  case COMM_LIMITER_CFG_DATA:

    memcpy(buffer_ptr, &(mtr_cfg.mtr_lmt_cfg), sizeof(mtr_cfg.mtr_lmt_cfg));
#ifdef MTR_SINGLE_PH
    big_endian_memcpy(buffer_ptr_endian,buffer_ptr_endian,mtr_lmt_cfg_ar_size,7);
#endif
    buffer_ptr += sizeof(mtr_cfg.mtr_lmt_cfg);
    return (buffer_ptr - buffer_index);
    
    break;
    
    
  case COMM_TAMPERS_CFG_DATA:
    memcpy(buffer_ptr, &(mtr_cfg.mtr_tmp_cfg), sizeof(mtr_cfg.mtr_tmp_cfg));
    buffer_ptr += sizeof(mtr_cfg.mtr_tmp_cfg);
    return (buffer_ptr - buffer_index);
    
    break;
    
  case COMM_OPERATING_POINT_CFG_DATA:
    
    memcpy(buffer_ptr, &(mtr_cfg.mtr_opr_cfg), sizeof(mtr_cfg.mtr_opr_cfg));
#ifdef MTR_SINGLE_PH
    var_temp_size =0xa2;
     big_endian_memcpy(buffer_ptr_endian,buffer_ptr_endian,&var_temp_size,4);
#endif
    buffer_ptr += sizeof(mtr_cfg.mtr_opr_cfg);
    return (buffer_ptr - buffer_index);
    
    break;
    
  case COMM_ID_CFG_DATA:

    memcpy(buffer_ptr, &(ctrl_cfg.id), sizeof(ctrl_cfg.id));
#ifdef MTR_SINGLE_PH
    big_endian_memcpy(buffer_ptr_endian,buffer_ptr_endian,id_ar_size,6);
#endif
    buffer_ptr += sizeof(ctrl_cfg.id);
    return (buffer_ptr - buffer_index);
    
    break;
    
  case COMM_ACTIONS_ALARMS_CFG_DATA:
    
    memcpy(buffer_ptr, &(ctrl_cfg.tmpr), sizeof(ctrl_cfg.tmpr));
    buffer_ptr += sizeof(ctrl_cfg.tmpr);
    return (buffer_ptr - buffer_index);
    
    break;
    
  case COMM_TIME_CFG_DATA:
    
    memcpy(buffer_ptr, &(ctrl_sys_var_optional_feature.rtc_time), sizeof(ctrl_sys_var_optional_feature.rtc_time));
    buffer_ptr += sizeof(ctrl_sys_var_optional_feature.rtc_time);
    return (buffer_ptr - buffer_index);
    
    break;
    
  case COMM_DATE_CFG_DATA:
    
    memcpy(buffer_ptr, &(ctrl_sys_var_optional_feature.rtc_date), sizeof(ctrl_sys_var_optional_feature.rtc_date));
    buffer_ptr += sizeof(ctrl_sys_var_optional_feature.rtc_date);
    return (buffer_ptr - buffer_index);
    
    break;
    
  case COMM_BATTERY_CFG_DATA:
    
    memcpy(buffer_ptr, &(ctrl_cfg.btry), sizeof(ctrl_cfg.btry));
    buffer_ptr += sizeof(ctrl_cfg.btry);
    return (buffer_ptr - buffer_index);
    
    break;
#if (CTRL_MGNT_SW ==1 && CTRL_MGNT_SENSOR == 1 )
  case COMM_MAGNETIC_CFG_DATA:
    memcpy(buffer_ptr, &(ctrl_cfg.mgnt), sizeof(ctrl_cfg.mgnt));
    buffer_ptr += sizeof(ctrl_cfg.mgnt);
    return (buffer_ptr - buffer_index); 
    break;
#endif
#ifdef RFID_FEATURE    
  case COMM_RFID_UNIQUE_ID_CFG_DATA:
    memcpy(buffer_ptr, &(ctrl_sys_var.basic.rfid_unique), sizeof(ctrl_sys_var.basic.rfid_unique));
    buffer_ptr += sizeof(ctrl_sys_var.basic.rfid_unique);
    return (buffer_ptr - buffer_index);  
    break;
#endif
#ifdef GPRS_FEATURE
  case COMM_GPRS_CFG_DATA:
    
    memcpy(buffer_ptr, &(gprs_ctl), sizeof(gprs_ctl));
    buffer_ptr += sizeof(gprs_ctl);
    return (buffer_ptr - buffer_index);
#endif
    break;
#if (defined(CTRL_RLY) && defined(MTR_ENABLE_LMT))    
  case COMM_OVERLOAD_ALARMS_CFG_DATA:
    memcpy(buffer_ptr, &(ctrl_cfg.overload), sizeof(ctrl_cfg.overload));
    buffer_ptr += sizeof(ctrl_cfg.overload);
    return (buffer_ptr - buffer_index); 
    break;
#endif   

  case COMM_RETURN_CORRUPTION:
    memcpy(buffer_ptr,(uint8_t*)&eeprom_load_errors_register, sizeof(eeprom_load_errors_register));
    buffer_ptr += sizeof(eeprom_load_errors_register);
    
    cal = (uint16_t)RTC->CAL;
    memcpy(buffer_ptr,(uint8_t*)&cal, sizeof(cal));
    buffer_ptr += sizeof(cal);
#ifdef MTR_SINGLE_PH
    big_endian_memcpy(buffer_ptr_endian,buffer_ptr_endian,Corruption_reading_ar_size,sizeof(cal)+sizeof(eeprom_load_errors_register));
#endif
#ifdef STS_ENABLE
    memcpy(buffer_ptr,(uint8_t*)&STS_Master.STS_PRIMARY_KEY, sizeof(STS_Master.STS_PRIMARY_KEY));
    buffer_ptr += sizeof(STS_Master.STS_PRIMARY_KEY);
#endif
#ifdef RF_CC1120
    CC1120_Get_Important_Flags();
    memcpy(buffer_ptr,(uint8_t*)RF_flags_arr, sizeof(RF_flags_arr));
    buffer_ptr += sizeof(RF_flags_arr);
#endif
    return (buffer_ptr - buffer_index);
    break;

  case COMM_RETURN_NEW_CTRL_DATA://need test
    memcpy(buffer_ptr, (uint8_t*)&ctrl_sys_new_var, sizeof(ctrl_sys_new_var));    
#ifdef MTR_SINGLE_PH
    big_endian_memcpy(buffer_ptr,buffer_ptr,ctrl_sys_new_var_t_ar_size,sizeof(ctrl_sys_new_var));
#endif
    return (sizeof(ctrl_sys_new_var));
  default:
    /*! - The MSB refered that the command for reading data EEPROM.
    The other 7bit represents the page number to be read.
    */
#if 1
    if (type >= COMM_READ_DATA_EEPROM_PAGES)
    {
      EEPROM_read(0xa4, buffer_ptr, ((type&(~COMM_READ_DATA_EEPROM_PAGES))*EEPROM_PAGE_SIZE), EEPROM_PAGE_SIZE);
      return EEPROM_PAGE_SIZE;
    }
#endif
    return 0;
  }
}


uint8_t comm_remote_programming(uint8_t *buff,uint16_t size)
{
  uint16_t temp_size = buff[2]*256 + buff[1]; 
  if ((buff[0] == STX)&&(buff[size-5]=='!')&&(buff[size-4]==CR)\
    &&(buff[size-3]==LF)&&(buff[size-2]==ETX))
  {
    if(buff[size-1] == calc_crc(&buff[1], temp_size+4 ,CRC) )
    {
#ifdef  GPRS_FEATURE
      gprs_lcd_icon = TRUE;
#endif
      if(temp_size > 4)
      {
        buff[1] = comm_handle_rx_bootloader_data(&buff[4], temp_size-3);
        //Form ACK Message
        buff[0] = ACK;
        buff[2] = current_pckt_ID >> 8  ;
        buff[3] = current_pckt_ID ;
        buff[4] = CR;
        buff[5] = tmp_crc;
        
        Boot_loader_timeout = 0;
      } 
      //RX end frame
      else if (temp_size == 4 && tmp_crc == buff[4])
      {
        //send Ack with last end N packet IDs
        Boot_loader_timeout = 0;
        buff[0] = ACK;
        buff[1] = 'A' ;
        buff[2] = current_pckt_ID >> 8  ;
        buff[3] = current_pckt_ID ;
        buff[4] = CR;
        buff[5] = tmp_crc;
        //clear boot loader flag
        Boot_loader_flag = NO_BOOTLOADER_DATA ;
        //save critical data and reset
        ctrl_event(CTRL_SAVE_CRITICAL_DATA);//IEC_62056_21_SAVE_METER_DATA();
        //SetBootLoaderKey();
        return true;
      }
      else
      {
        buff[1] = 'R';
        //Form ACK Message
        buff[0] = ACK;
        buff[2] = current_pckt_ID >> 8  ;
        buff[3] = current_pckt_ID ;
        buff[4] = CR;
        buff[5] = tmp_crc;
        
        Boot_loader_timeout = 0;
#ifdef  GPRS_FEATURE
        gprs_lcd_icon = FALSE;
#endif
      }
    } 
    else
    {
      buff[1] = 'R';
      //Form ACK Message
      buff[0] = ACK;
      buff[2] = current_pckt_ID >> 8;
      buff[3] = current_pckt_ID ;
      buff[4] = CR;
      buff[5] = LF;
      
      Boot_loader_timeout = 0;
#ifdef  GPRS_FEATURE
      gprs_lcd_icon = FALSE;
#endif
    }
  }
  else
  {
#ifdef  GPRS_FEATURE
    gprs_lcd_icon = FALSE;
#endif
    buff[1] = 'R';
    //Form ACK Message
    buff[0] = ACK;
    buff[2] = current_pckt_ID >> 8;
    buff[3] = current_pckt_ID ;
    buff[4] = CR;
    buff[5] = LF;
    
    Boot_loader_timeout = 0;
#ifdef  GPRS_FEATURE
    gprs_lcd_icon = FALSE;
#endif
  }
  return false;
}
/*!
* @brief Initializtion of all communication interfaces.
*
* @par Description:
* Initailize different communication interfaces.
*
* @return
* - None.
*/
void comm_init(void)
