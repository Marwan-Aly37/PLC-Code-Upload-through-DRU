      memcpy((&ctrl_sys_var_optional_feature.tax_nk_value),(data_ptr + 1+fnshd_cmd_data_size), sizeof(ctrl_sys_var_optional_feature.tax_nk_value));

      ctrl_sys_var_optional_feature.acc_nkwh_consumbtion = 0;
      if (ctrl_sys_var_optional_feature.tax_limit != 0)
        ctrl_sys_var_optional_feature.acc_nkwh_consumbtion = trf_pymt_var.trf_data.curr_bp_actv_wh %(uint32_t)(ctrl_sys_var_optional_feature.tax_limit*(uint32_t)1000);
      fnshd_cmd_data_size += sizeof(ctrl_sys_var_optional_feature.tax_nk_value);
      calc_bill_flag=1;
      break;
    case CTRL_SET_CONSUMPTION_ALARM_VALUE:
#ifdef MTR_SINGLE_PH
      var_temp_size =0xc0;
      big_endian_memcpy(data_ptr + 1, data_ptr + 1,&var_temp_size, 4);
#endif
      memcpy((&ctrl_sys_var_optional_feature.ctrl_consumption_alarm_value),(data_ptr + 1), sizeof(ctrl_sys_var_optional_feature.ctrl_consumption_alarm_value));
      fnshd_cmd_data_size = sizeof(ctrl_sys_var_optional_feature.ctrl_consumption_alarm_value);
      break;
    case CTRL_SET_CONSUMPTION_GRACE_AFTER_RECALC:
