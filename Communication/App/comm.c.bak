#endif
#ifdef DLMS_UI
  UI_Task();
#endif
#ifdef ANSI_STACK
Optical_task();
handle_Scalling_Frame_Task();
#endif  
  }
  Image_Gen_task();
  UpdateBootLoaderImage_task();
  
#ifdef STS_ENABLE 
  if (STS_flag == 1)
  STS_push_Token_Data(g_Token); 
  STS_engine ();
#endif
}

