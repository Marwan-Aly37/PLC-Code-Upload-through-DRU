        if(temp < OVERFLOW_THERSHOLD)
        {
          memcpy(&(mtr_data.mtr_data_mem.mtr_acc_md.acc_mic_en_reg.acc_en_reg.tot_act_en.low_reg), data_ptr + 1, sizeof( mtr_data.mtr_data_mem.mtr_acc_md.acc_mic_en_reg.acc_en_reg.tot_act_en.low_reg));
         
