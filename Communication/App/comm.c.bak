      fnshd_cmd_data_size = sizeof(ctrl_sys_var_second_optional_feature.gprs_resetTimeOut);
      break;
    case SET_GPRS_WAIT_ACK_TIMEOUT:
#ifdef MTR_SINGLE_PH
