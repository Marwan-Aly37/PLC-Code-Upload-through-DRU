#endif
      memcpy((uint8_t*)&ctrl_sys_var_optional_feature.tax_nk_value2,(data_ptr + sizeof(ctrl_sys_var_optional_feature.tax_limit2) + 1),sizeof(ctrl_sys_var_optional_feature.tax_nk_value2));
      ctrl_sys_new_var.nk_limit_maximum2 = *(data_ptr + sizeof(ctrl_sys_var_optional_feature.tax_limit2) + 1 + sizeof(ctrl_sys_var_optional_feature.tax_nk_value2));
